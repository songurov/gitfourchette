/* ---------------------------------------------------------------------------
 * "Modern" theme for GitFourchette.
 *
 * This is a template: placeholder tokens are substituted by themes.py.
 * This stylesheet is appended to the base stylesheet.
 * ------------------------------------------------------------------------ */

/* --------------------------------------------------------------------------
 * Window chrome
 * ------------------------------------------------------------------------ */

QMainWindow, QDialog {
    background: ${bg};
}

QMainWindow::separator {
    background: ${border};
    width: 1px;
    height: 1px;
}

QToolTip {
    background: ${tooltipBg};
    color: ${tooltipText};
    border: 1px solid ${tooltipBorder};
    border-radius: ${menuRadius};
    padding: 2px 4px;
}

QStatusBar {
    background: ${bg};
    color: ${textDim};
    border-top: 1px solid ${border};
}

QStatusBar::item {
    border: none;
}

QStatusBar MemoryIndicator {  /* in debug mode only */
    padding: 0;
}

/* --------------------------------------------------------------------------
 * Menu bar & menus
 * ------------------------------------------------------------------------ */

QMenuBar {
    background: ${bg};
    color: ${text};
    border: none;
    padding: 2px 3px;
}

QMenuBar::item {
    background: transparent;
    color: ${text};
    padding: 4px 9px;
    margin: 0px 1px;
    border-radius: ${outerRadius};
}

QMenuBar::item:selected {
    background: ${hover};
}

QMenuBar::item:pressed {
    background: ${accent};
    color: ${onAccent};
}

QMenu, QComboBox QAbstractItemView {
    border-radius: ${menuRadius};
    background: ${button};
    color: ${text};
    border: 1px solid ${border};
    padding: 5px 4px;
}

QComboBox QAbstractItemView {
    border-radius: ${comboBoxMenuRadius};
}

QMenu::item {
    background: transparent;
    padding: 5px 24px 5px 8px;
    border-radius: ${innerRadius};
    margin: 0px 2px;
}

QMenu::item:selected {
    background: ${accent};
    color: ${onAccent};
}

QMenu::item:disabled {
    background: transparent;
    color: ${textFaint};
}

QMenu::separator {
    height: 1px;
    background: ${border};
    margin: 5px 8px;
}

QMenu::icon {
    margin-left: 7px;
}

QMenu::indicator {
    margin-left: 8px;
    width: 13px;
    height: 13px;
}

/* --------------------------------------------------------------------------
 * Main toolbar
 * ------------------------------------------------------------------------ */

QToolBar {
    background: ${bg};
    border: none;
    padding: ${toolbarPadding};
    spacing: 2px;
    border-bottom: ${toolbarBorderWidth}px solid ${border};
}

QToolBar[borderless] {
    border-bottom: none;
}

QToolBar::separator {
    background: ${border};
    width: 1px;
    height: 1px;
    margin: 5px 7px;
}

/* --------------------------------------------------------------------------
 * Buttons
 * ------------------------------------------------------------------------ */

QPushButton,
QToolButton {
    background: ${button};
    color: ${text};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
}

QToolButton {
    padding: ${toolButtonPadding};
}

QPushButton {
    padding: ${buttonPadding};
    min-width: 56px;
}

QPushButton:flat,
QToolButton[autoRaise="true"] {
    border-color: transparent;
    background: transparent;
}

QPushButton:hover,
QToolButton:hover,
QToolButton:focus {
    background: ${buttonHover};
}

QToolButton[autoRaise="true"]:hover {
    background: ${hover};
}

QPushButton:pressed {
    padding-bottom: 3px;
}

QToolButton:pressed {
    padding-bottom: 1px;
}

QToolButton:disabled {
    background: transparent;
    color: ${textFaint};
}

QToolButton[popupMode="1"] { /* MenuButtonPopup */
    padding-right: 20px; /* make way for the popup button */
}

QToolButton::menu-button {
    border-left: 1px solid ${border};  /* clear hint that menu-button is a separate click zone */
    border-top-right-radius: ${outerRadius};
    border-bottom-right-radius: ${outerRadius};
    width: 20px;
}

/* Autoraise (e.g. toolbar): bring menu button a little closer to button text */
QToolButton[autoRaise="true"][popupMode="1"] {
    padding-right: 16px;
}

QToolButton[autoRaise="true"][popupMode="1"]::menu-button {
    width: 18px;
    border-color: transparent;
}

QToolButton[autoRaise="true"][popupMode="1"]::menu-button:hover {
    border-left-width: 2px;
    border-color: ${textFaint};
}

QToolButton::menu-arrow {
    width: 8px;
    height: 8px;
    image: url('assets:icons/qss-down.svg');
}

QPushButton:default, QPushButton:focus, QToolButton:focus {
    border-color: ${accent};
}

QPushButton:default {
    background: ${defaultButton};
}

QPushButton:default:hover {
    background: ${defaultButtonHover};
}

QPushButton:default:pressed,
QPushButton:pressed,
QToolButton:pressed {
    background: ${buttonPressed};
}

QToolButton:checked,
QToolButton:on {
    background: ${hover};
}

QPushButton:disabled {
    background: ${inputDisabled};
    color: ${textFaint};
    border-color: ${border};
}

QPushButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

/* --------------------------------------------------------------------------
 * Text entry & combo boxes
 * ------------------------------------------------------------------------ */

QLineEdit,
QSpinBox,
QDateTimeEdit,
QComboBox,
QTextEdit,
QPlainTextEdit {
    background: ${fieldBg};
    color: ${text};
    border: 1px solid ${fieldBorder};
    border-radius: ${outerRadius};
    padding: ${fieldPadding};
    selection-background-color: ${accent};
    selection-color: ${onAccent};
}

QComboBox {
    padding-right: 1em;
}

QSpinBox::down-button, QSpinBox::up-button {
    subcontrol-origin: padding;
    width: 20px;
    height: 100%;
    border: 0px solid ${border};
}

QSpinBox::down-button {
    subcontrol-position: left;
    border-right-width: 1px;
}

QSpinBox::up-button {
    subcontrol-position: right;
    border-left-width: 1px;
}

QSpinBox::down-arrow {
    image: url(assets:icons/qss-minus.svg);
}

QSpinBox::up-arrow {
    image: url(assets:icons/qss-plus.svg);
}

QLineEdit:focus,
QSpinBox:focus,
QDateTimeEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:on,
QComboBox::drop-down:focus,
QComboBox::drop-down:on,
QSpinBox::down-button:focus,
QSpinBox::up-button:focus {
    border-color: ${accent};
}

QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background: ${inputDisabled};
    color: ${textFaint};
    border-color: ${border};
}

QComboBox::drop-down,
QDateTimeEdit::drop-down {
    width: 19px;
    border-left: 1px solid ${border};
}

QComboBox::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(assets:icons/qss-down.svg);
}

/* --------------------------------------------------------------------------
 * Tab bars
 * ------------------------------------------------------------------------ */

QTabBar {
    background: transparent;
    qproperty-drawBase: 0;
    border-bottom: 1px solid ${border};
}

QTabBar::tab {
    color: ${textDim};
    margin-left: 1px;
    margin-right: 1px;

    padding: ${tabPadding};
    border-radius: ${outerRadius};
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    border: 1px solid transparent;
    border-bottom: 0;
    border-color: transparent;
}

QTabWidget2 QTabBar[expanding="true"]::tab:first {
    border-top-left-radius: 0px;
    border-left: none;
}

QTabWidget2 QTabBar[expanding="true"]::tab:last {
    border-top-right-radius: 0px;
    border-right: none;
}

QTabBar::tab:hover {
    background: ${hover};
    color: ${text};
}

QTabBar::tab:selected {
    border-color: ${border};
    background-color: ${surface};
    font-weight: bold;
}

QTabBar::close-button {
    margin-right: 3px;
    border-radius: ${innerRadius};
    padding: 3px;
    image: url("assets:icons/qss-closetab.svg");
}

QTabBar::close-button:hover {
    background: ${danger};
    image: url("assets:icons/qss-closetab-hover.svg");
}

/* --------------------------------------------------------------------------
 * Splitters
 * ------------------------------------------------------------------------ */

QSplitter::handle {
    background: ${splitterHandle};
}

QSplitter::handle:hover, QSplitter::handle:pressed {
    background: ${accent};
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QFaintSeparator {
    background: ${border};
    border: none;
}

/* --------------------------------------------------------------------------
 * Item views
 * ------------------------------------------------------------------------ */

QAbstractItemView {
    background: ${surface};
    color: ${text};
    alternate-background-color: ${altRow};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
}

QAbstractItemView:focus, QAbstractItemView:focus {
    border-color: ${accent};
}

QComboBox QAbstractItemView:focus {  /* kill accent border on QComboBox menu */
    border-color: ${border};
}

RepoWidget Sidebar, RepoWidget FileList, RepoWidget GraphView {
    border: none;
    border-radius: 0;
    outline: 0;
}

QAbstractItemView {
    padding: 1px;
}

QAbstractItemView::item {
    color: ${text};
    border-radius: ${innerRadius};
}

QAbstractItemView::item:hover {
    background: ${hover};
}

QAbstractItemView::item:selected {
    background: ${selInactive};
    color: ${text};
}

QAbstractItemView::item:selected:active {
    background: ${accent};
    color: ${onAccent};
}

/* --------------------------------------------------------------------------
 * Scroll bars
 * ------------------------------------------------------------------------ */

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 0;
    border: none;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 0;
    border: none;
}

QScrollBar::handle {
    background: ${scrollHandle};
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    min-height: 32px;
    margin: 1px ${scrollHandleMargin};
}

QScrollBar::handle:horizontal {
    min-width: 32px;
    margin: ${scrollHandleMargin} 1px;
}

QScrollBar::handle:hover, QScrollBar::handle:pressed {
    background: ${accent};
}

QScrollBar::add-line, QScrollBar::sub-line {
    background: transparent;
    border: none;
    width: 0;
    height: 0;
}

QScrollBar::up-arrow, QScrollBar::down-arrow,
QScrollBar::left-arrow, QScrollBar::right-arrow {
    background: transparent;
    image: none;
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* --------------------------------------------------------------------------
 * Misc controls
 * ------------------------------------------------------------------------ */

QGroupBox {
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    padding: 4px;
}

QProgressBar {
    background: ${surface};
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    text-align: center;
    color: ${text};
}

QProgressBar::chunk {
    background: ${accent};
    border-radius: ${innerRadius};
    margin: 1px;
}

/* --------------------------------------------------------------------------
 * GitFourchette-specific widgets
 * ------------------------------------------------------------------------ */

GraphView::item, FileList::item {
    border-radius: 0;
}

Sidebar::item { height: ${sidebarRowHeight}; }
FileList::item, StashDialog #fileList::item { height: ${fileRowHeight}; }

Sidebar {
    background: palette(window);
    color: ${text};
    show-decoration-selected: 1;
}

Sidebar::item {
    border-radius: ${innerRadius};
    border-bottom-left-radius: 0px;
    border-top-left-radius: 0px;
}

Sidebar::item:hover:!selected {
    border-radius: 0px;  /* avoid "dented" effect */
}

/* Code panes must stay flush - no rounded frame, no inner padding. */
CodeView, SpecialDiffView {
    background: ${surface};
    border: none;
    border-radius: 0;
    padding: 0;
}

/* Don't shrink icons in small QToolButtons */
QHintButton, ContextHeader QToolButton {
    padding-top: 0px;
    padding-bottom: 0px;
}

/* Icon buttons fixed at 24x24: 7px on either side would squeeze their 16px
   icon into 8px. */
DiffButtons QToolButton, DiffArea QToolButton#fileViewButton {
    padding: 0px 3px;
}

/* Like the diff buttons' menus, no arrow drawn over the icon */
DiffArea QToolButton#fileViewButton::menu-indicator {
    image: none;
}

DiffArea QLabel.panelTitle {
    color: ${textDim};
}

/* Secondary text, e.g. a sample of what a setting produces */
QLabel.secondary {
    color: ${textDim};
}

/* Settings fields get an outline that reads at 3:1 against the window. The
   :focus and :disabled rules above still win over this one. */
PrefsDialog QLineEdit,
PrefsDialog QSpinBox,
PrefsDialog QComboBox,
PrefsDialog QPlainTextEdit {
    border-color: ${controlBorder};
}

/* Settings' pop-up menus are one button, like a Mac pop-up button: a chevron
   pair, no separate drop-down box. */
PrefsDialog QComboBox::drop-down {
    border-left: none;
    width: 18px;
}

PrefsDialog QComboBox::down-arrow {
    image: url(assets:icons/qss-updown.svg);
    width: 8px;
    height: 12px;
}

/* Settings' pane switcher (macOS): a row of icons with their names, the
   current one on a rounded fill with a brighter name. */
PrefsDialog QToolBar#PrefsPaneBar {
    background: ${bg};
    border: none;
    border-bottom: 1px solid ${border};
    padding: 6px 12px 7px 12px;
    spacing: 2px;
}

PrefsDialog QToolBar#PrefsPaneBar QToolButton {
    background: transparent;
    border: none;
    border-radius: ${outerRadius};
    color: ${textDim};
    padding: 5px 8px 4px 8px;
    min-width: 50px;
}

PrefsDialog QToolBar#PrefsPaneBar QToolButton:hover {
    background: ${hover};
}

PrefsDialog QToolBar#PrefsPaneBar QToolButton:checked {
    background: ${selInactive};
    color: ${text};
}

/* Elsewhere, a list on the left */
PrefsDialog QListWidget#PrefsPaneList::item {
    padding: 4px 6px;
}

SearchBar QLineEdit {
    border: 1px solid ${border};
    border-radius: ${outerRadius};
    padding: 3px 0px;
}

SearchBar[red] QLineEdit {
    color: ${danger};
    border-color: ${danger};
}

/* Fusion quirk: QComboBox's list view always inherits QComboBox's top-padding.
https://web.archive.org/web/qtcentre.org/threads/69272-QComboBox-padding-bug */
${fusionOnly}QComboBox { combobox-popup: 0; }
${fusionOnly}QComboBox QAbstractItemView::item { padding: 4px 2px; }

/* --------------------------------------------------------------------------
 * Neutral variant only
 * ------------------------------------------------------------------------ */

/* Repo tabs: pills on a rounded track, instead of folder tabs. The track is
   28px tall, the pills 24px, with a pixel of track showing around them. */
${neutralOnly}QTabWidget2 QTabBar {
    background: ${tabTrack};
    border: 1px solid ${tabTrackEdge};
    border-radius: ${tabTrackRadius};
}

${neutralOnly}QTabWidget2 QTabBar::tab,
${neutralOnly}QTabWidget2 QTabBar[expanding="true"]::tab:first,
${neutralOnly}QTabWidget2 QTabBar[expanding="true"]::tab:last {
    height: 22px;
    margin: 2px;
    padding: 0px 6px;
    border: 1px solid transparent;
    border-radius: ${pillRadius};
}

/* Under the pointer, a tab gets the pill's fill, but not its rim */
${neutralOnly}QTabWidget2 QTabBar::tab:hover:!selected {
    background: ${tabPill};
}

${neutralOnly}QTabWidget2 QTabBar::tab:selected,
${neutralOnly}QTabWidget2 QTabBar[expanding="true"]::tab:first:selected,
${neutralOnly}QTabWidget2 QTabBar[expanding="true"]::tab:last:selected {
    background: ${tabPill};
    /* Lit along the top and bottom, in shadow at the rounded ends */
    border-color: ${tabPillEdge} ${tabPillShade};
    color: ${tabActiveText};
    font-weight: normal;
}

/* Each tab's close button, at its left end while the pointer is over it */
${neutralOnly}QTabWidget2 QToolButton#QTW2CloseButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
}

${neutralOnly}QTabWidget2 QToolButton#QTW2CloseButton:hover {
    background: ${hover};
}

/* The round "+" after the tabs */
${neutralOnly}QTabWidget2 QToolButton#QTW2NewTabButton {
    background: ${newTabButton};
    border: 1px solid;
    border-color: ${newTabButtonEdge} ${newTabButtonShade};
    border-radius: 14px;
    padding: 0px;
}

${neutralOnly}QTabWidget2 QToolButton#QTW2NewTabButton:hover,
${neutralOnly}QTabWidget2 QToolButton#QTW2NewTabButton:pressed {
    background: ${tabPillEdge};
}

/* Check boxes a little larger, as on the Mac. Only the size: the drawing stays the style's own. */
${neutralOnly}QCheckBox::indicator {
    width: 16px;
    height: 16px;
}

${neutralOnly}ContextHeader {
    background-color: ${panelHeader};
}

/* Main toolbar: short dim labels under the icons. The repo and branch in the
   middle aren't a label, so they keep the normal text color. */
${neutralOnly}#GFToolbar QToolButton {
    color: ${textDim};
    padding: 2px 2px;
}

${neutralOnly}#GFToolbar QToolButton:disabled {
    color: ${textFaint};
}

${neutralOnly}#GFToolbar QToolButton#GFToolbarRepoButton {
    color: ${text};
}

/* File lists: rows inset from the edges (FileList.rowRightInset keeps the
   right edge's room clear of the scroll bar). FileList paints the selection
   itself, as a rounded pill across the whole row; Fork shows no hover. */
${neutralOnly}RepoWidget FileList {
    padding: ${fileListInset}px 0px 0px ${fileListInset}px;
    show-decoration-selected: 0;
}

${neutralOnly}FileList::item:hover,
${neutralOnly}FileList::item:selected,
${neutralOnly}FileList::item:selected:active {
    background: transparent;
}

/* The strip over a file list: its name in bold, the main action as a pill */
${neutralOnly}DiffArea #fileListHeader {
    background: ${panelHeader};
    border-bottom: 1px solid ${border};
}

${neutralOnly}DiffArea #fileListHeader QLabel.panelTitle {
    color: ${text};
}

${neutralOnly}DiffArea #fileListHeader QToolButton.pill {
    background: ${button};
    color: ${text};
    border: none;
    border-radius: ${outerRadius};
    padding: 0px 7px;
}

${neutralOnly}DiffArea #fileListHeader QToolButton.pill:hover {
    background: ${buttonHover};
}

${neutralOnly}DiffArea #fileListHeader QToolButton.pill:pressed {
    background: ${buttonPressed};
}

${neutralOnly}DiffArea #fileListHeader QToolButton.pill:disabled {
    background: ${pillDisabled};
    color: ${textFaint};
}

/* The list/tree switch is a plain icon, like Fork's: no arrow for its menu */
${neutralOnly}DiffArea #fileListHeader QToolButton::menu-indicator {
    image: none;
    width: 0px;
}

/* --------------------------------------------------------------------------
 * Source-list sidebar only (see ThemeColors.sidebarSourceList)
 * ------------------------------------------------------------------------ */

/* SidebarDelegate paints the selection and the hover as a pill inset from the
   edges. Nothing else may fill the row, the margin left of it included. */
${sourceListOnly}Sidebar {
    show-decoration-selected: 0;
}

${sourceListOnly}Sidebar::item,
${sourceListOnly}Sidebar::item:hover,
${sourceListOnly}Sidebar::item:selected,
${sourceListOnly}Sidebar::item:selected:active {
    background: transparent;
/* Short dividers between fetch, pull and push, level with the icons */
${neutralOnly}QToolBar#GFToolbar::separator {
    background: ${toolbarDivider};
    width: 1px;
    margin: 4px 2px 24px 2px;
}

${neutralOnly}QToolBar#GFToolbar[compact="true"]::separator {
    margin: 5px 2px;
}

/* The box in the middle: the repo in bold, over its branch */
#GFRepoBox {
    background: ${tabTrack};
    border-radius: ${outerRadius};
}

#GFRepoBox QLabel {
    color: ${text};
}

#GFRepoBox QToolButton {
    color: ${repoBoxDim};
    background: transparent;
    border: none;
    padding: 0px 12px 0px 0px;
}

#GFRepoBox QToolButton:hover,
#GFRepoBox QToolButton:pressed {
    color: ${text};
    background: transparent;
}

#GFRepoBox QToolButton#GFRepoBoxBranch::menu-indicator {
    image: url(assets:icons/qss-chevron-down.svg);
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 8px;
    height: 8px;
}

/* No drop-down marks under Open In, Theme and Workspace: a click opens their menu */
${neutralOnly}#GFToolbar QToolButton::menu-indicator {
    image: none;
    width: 0px;
}
